# Suivi de commande côté serveur (facultatif).
# Sans ces variables le site fonctionne, mais /suivi retombe sur la copie
# conservée sur l'appareil du client au lieu d'interroger la base.
#
# NE JAMAIS préfixer la clé service_role par NEXT_PUBLIC_ : elle contourne
# RLS et ne doit jamais atteindre le navigateur.
SUPABASE_URL=https://pmqdltywisvlmuuwcxpb.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────────────────────────────────────────────────────
# Réponses automatiques aux messages privés et commentaires Instagram /
# Facebook (voir README §8 et la console /auto-reponses).
# Sans ces variables le site fonctionne : /api/social/webhook refuse
# simplement les évènements (503), rien d'autre ne change.
#
# NE JAMAIS préfixer ces valeurs par NEXT_PUBLIC_ : ce sont des secrets.
META_VERIFY_TOKEN=
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=
# Ids de la Page Facebook et du compte Instagram pro : facultatifs, ils
# évitent que le robot réponde à ses propres commentaires.
META_PAGE_ID=
META_IG_ID=
# 'off' = mode simulation : les réponses sont calculées et tracées dans les
# logs, mais rien n'est publié. À utiliser le temps de relire le robot.
SOCIAL_AUTOREPLY=
