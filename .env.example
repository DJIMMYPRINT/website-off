# Suivi de commande côté serveur (facultatif).
# Sans ces variables le site fonctionne, mais /suivi retombe sur la copie
# conservée sur l'appareil du client au lieu d'interroger la base.
#
# NE JAMAIS préfixer la clé service_role par NEXT_PUBLIC_ : elle contourne
# RLS et ne doit jamais atteindre le navigateur.
SUPABASE_URL=https://pmqdltywisvlmuuwcxpb.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Tri automatique des photos produit depuis l'iPhone (voir RACCOURCI-PHOTOS.md).
# Sans ces deux variables, /api/classify-photo répond 503 et le reste du site
# n'est pas affecté.
#
# CLASSIFY_SECRET est le mot de passe partagé avec le raccourci iOS : le site
# est public, donc sans lui n'importe qui pourrait consommer notre quota.
ANTHROPIC_API_KEY=
CLASSIFY_SECRET=
# Facultatif. Par défaut claude-opus-5 ; claude-haiku-4-5 coûte ~5x moins cher.
CLASSIFY_MODEL=
