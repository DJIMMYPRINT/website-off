# Suivi de commande côté serveur (facultatif).
# Sans ces variables le site fonctionne, mais /suivi retombe sur la copie
# conservée sur l'appareil du client au lieu d'interroger la base.
#
# NE JAMAIS préfixer la clé service_role par NEXT_PUBLIC_ : elle contourne
# RLS et ne doit jamais atteindre le navigateur.
SUPABASE_URL=https://pmqdltywisvlmuuwcxpb.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Automatismes réseaux sociaux (facultatif) : réponses aux DM et campagnes
# « commente un mot -> reçois le lien en privé ».
# Sans ces variables /api/social/webhook reste inerte : il accuse réception,
# écrit dans les logs la réponse qu'il aurait envoyée, et n'envoie rien.
# Mode d'emploi complet : docs/AUTO-REPONSES.md
META_VERIFY_TOKEN=
META_APP_SECRET=
META_PAGE_TOKEN=

# Multi-comptes : identifiants de Page / de compte Instagram professionnel,
# séparés par une virgule. Tant qu'ils sont vides, tout est traité comme le
# compte Djimmy Prints.
SOCIAL_IDS_DJIMMY=
# META_TOKEN_DJIMMY=        # jeton propre au compte (sinon META_PAGE_TOKEN)
SOCIAL_IDS_AMOURI=
META_TOKEN_AMOURI=

WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# AUTOREPLY_ENABLED=false     # coupe toutes les réponses sans redéployer
# COMMENT_PUBLIC_REPLY=false  # garde le DM mais arrête les réponses publiques
