# Suivi de commande côté serveur (facultatif).
# Sans ces variables le site fonctionne, mais /suivi retombe sur la copie
# conservée sur l'appareil du client au lieu d'interroger la base.
#
# NE JAMAIS préfixer la clé service_role par NEXT_PUBLIC_ : elle contourne
# RLS et ne doit jamais atteindre le navigateur.
SUPABASE_URL=https://pmqdltywisvlmuuwcxpb.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ─── Atelier (/atelier) — assistant commercial vocal ──────────────────
#
# Sans ces variables la page s'ouvre et fonctionne, mais le micro ne mène
# à rien : la transcription et l'agent répondent 503, et la saisie au
# clavier reste le seul chemin. Les tâches, elles, vivent de toute façon
# sur l'appareil ; SUPABASE_SERVICE_ROLE_KEY ci-dessus suffit à les
# synchroniser entre téléphone et ordinateur.

# Clé Anthropic pour l'agent qui structure les notes (console.anthropic.com).
ANTHROPIC_API_KEY=

# Transcription : tout point d'entrée compatible Whisper.
# Par défaut OpenAI ; Groq (https://api.groq.com/openai/v1/audio/transcriptions,
# modèle whisper-large-v3) revient nettement moins cher et répond plus vite.
TRANSCRIBE_API_KEY=
TRANSCRIBE_URL=https://api.openai.com/v1/audio/transcriptions
TRANSCRIBE_MODEL=whisper-1
