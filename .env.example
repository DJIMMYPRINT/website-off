# Suivi de commande côté serveur (facultatif).
# Sans ces variables le site fonctionne, mais /suivi retombe sur la copie
# conservée sur l'appareil du client au lieu d'interroger la base.
#
# NE JAMAIS préfixer la clé service_role par NEXT_PUBLIC_ : elle contourne
# RLS et ne doit jamais atteindre le navigateur.
SUPABASE_URL=https://pmqdltywisvlmuuwcxpb.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Tarifs de livraison Yalidine affichés dans /commande (facultatif).
# Sans ces variables, /api/shipping répond 503 { configured: false } et le
# tunnel de commande masque simplement l'estimation : la commande part quand
# même sur WhatsApp, comme avant.
#
# Clés à créer depuis votre espace Yalidine, rubrique « Développement ».
# NE JAMAIS les préfixer par NEXT_PUBLIC_ : le token permet de créer, modifier
# et supprimer des colis sur le compte.
YALIDINE_API_ID=
YALIDINE_API_TOKEN=
# Wilaya de départ des colis. 16 = Alger (atelier d'Aïn Bénian).
YALIDINE_FROM_WILAYA_ID=16
